# Copy this file to .env and fill in your key:   cp .env.example .env
# .env is in .gitignore, so your key never gets committed.

# Tier 3 (LLM fallback). FREE, no credit card: https://aistudio.google.com/apikey
# Without it, Tier 3 is skipped and everything else still works.
GEMINI_API_KEY=

# Part 3 (optional): Hunter.io email finder, free plan, no credit card: https://hunter.io/api-keys
# Without it, contacts come only from public pages (company site, YC page, HN) and the GitHub API.
# HUNTER_API_KEY=

# Web app on your laptop: optional password for /admin (the hosted site uses accounts instead)
# SORT_SHERR_ADMIN_PASSWORD=

# Hosting (see README "Host it for other students"). Set DATABASE_URL here ONLY when you want local
# commands (copy-to-postgres, create-user, invite) to work on the Neon database instead of data/.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# SORT_SHERR_LOGIN=1                 # try the login pages locally
# SORT_SHERR_SESSION_SECRET=         # Render generates this one
# SORT_SHERR_EMBEDDER=fastembed      # matching without torch (Render uses this)
# SORT_SHERR_MAX_RESUMES=3
# SORT_SHERR_MAX_MATCH_RUNS=3

# Optional overrides
# SORT_SHERR_LLM_MODEL=gemini-3.5-flash-lite
# SORT_SHERR_LLM_MIN_INTERVAL=6
# SORT_SHERR_DB=data/sort_sherr.db
# SORT_SHERR_DAILY_DRAFT_CAP=10
# SORT_SHERR_BRIEF_MAX_AGE_DAYS=7
# SORT_SHERR_CONTACT=https://github.com/your-username/sort-sherr
